# TCP port to listen on (1-65535)
PORT=8080

# Directory downloads are streamed to disk under (created if missing).
# The plan's download.storage_path defaults to /data/downloads.
DOWNLOAD_STORAGE_PATH=/var/lib/download-service

# Max parallel downloads (download.concurrency).
DOWNLOAD_CONCURRENCY=4

# Path to the yt-dlp executable
YTDLP_PATH=yt-dlp

# Comma-separated list of allowed domains (download.allowed_domains).
# Leave empty to allow nothing (fail closed).
DOWNLOAD_ALLOWED_DOMAINS=youtube.com,www.youtube.com,m.youtube.com,youtu.be,www.youtu.be

# Where download results are POSTed when a download finishes
# (download.callback.url). Leave empty to disable callbacks.
CALLBACK_URL=http://notification-service/callback/download
