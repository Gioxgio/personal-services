# All variables below must be set; there are no defaults or fallbacks.
# Secrets are left blank here and filled in .env (which is gitignored).

# TCP port to listen on (1-65535)
PORT=8081

# Directory downloads are streamed to disk under (created if missing).
DOWNLOAD_STORAGE_PATH=/var/lib/download-service

# Max parallel downloads (1-1024)
DOWNLOAD_CONCURRENCY=4

# Path to the yt-dlp executable
YTDLP_PATH=yt-dlp

# Comma-separated list of allowed domains.
# Leave empty to allow nothing (fail closed).
DOWNLOAD_ALLOWED_DOMAINS=youtube.com,www.youtube.com,m.youtube.com,youtu.be,www.youtu.be

# Where download results are POSTed when a download finishes.
# Leave empty to disable callbacks.
CALLBACK_URL=http://notification-service:8080/callback/download

# Base URL for status notifications: events are POSTed to <NOTIFY_URL>/notifications.
# Leave empty to disable notifications.
NOTIFY_URL=http://notification-service:8080/notifications
