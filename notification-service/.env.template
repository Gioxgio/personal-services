PORT=8080

# Bot token issued by @BotFather (secret; .env only)
TELEGRAM_TOKEN=

# Target chat id, or @channelusername
TELEGRAM_CHAT_ID=63022479

# Download-service POST /download endpoint used by the /download command.
DOWNLOAD_SERVICE_URL=http://download-service:8081/download
