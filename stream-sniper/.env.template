# stream-sniper environment template.
#
# Copy to .env and fill in the secret values. Every variable below must be
# set: there are no defaults or fallbacks. An empty value is explicit and
# disables the feature it controls. Real credentials stay out of git -
# .env is ignored.

# --- Twitch credentials: needed for live-state probing ---
# Get a client id/secret from https://dev.twitch.tv/console (an app
# with no redirect URI is fine). TWITCH_TOKEN, when set, is used as a
# user access token instead of the client-id/secret pair.
TWITCH_CLIENT_ID=
# Secret: .env only.
TWITCH_CLIENT_SECRET=
# Secret: .env only.
TWITCH_TOKEN=

# --- Where ffmpeg-quiet/ffprobe live ---
# Install prefix's libexec/ (make install puts them in
# /usr/local/libexec/stream-sniper).
SS_WRAPPER_DIR=/usr/local/libexec/stream-sniper

# --- Recording notifications ---
# Base URL of the notification endpoint; stream-sniper POSTs
# {"source": "stream-sniper", "message": "<text>"} to
# <base>/notifications on every recording start/stop. The
# notification-service formats the text as "[source] message".
# Full URL, not just a port: host and port both change between
# docker setups. Empty = notifications off.
SS_NOTIFY_URL=http://192.168.1.100:8080
